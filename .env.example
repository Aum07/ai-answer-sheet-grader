# Copy to .env (never commit .env). All values are optional.
# Which model folder under models/ to use: mohler (default, real data) or synthetic
MODEL_NAME=mohler
# Require an X-API-Key header on /evaluate/ (leave empty for local use)
API_KEY=
MAX_UPLOAD_MB=10
MAX_STUDENT_FILES=30
RATE_LIMIT_PER_MINUTE=10
RESULT_TTL_SECONDS=3600
# Comma-separated origins if the UI is served from another domain
CORS_ORIGINS=
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# LLM grader (optional). Set the key in your shell, never commit it.
# OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
